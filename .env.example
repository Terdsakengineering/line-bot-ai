LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: publicly readable CSV URL (Google Sheets "Publish to web" or
# /export?format=csv link). When set, FAQ answers are fetched from this
# sheet instead of data/faq.csv, with data/faq.csv used as a fallback.
SHEET_CSV_URL=

# Optional but recommended: LINE user ID (1:1 chat) or group ID that
# receives Smart Handoff notifications (customer wants a human / is
# complaining). See README.md "วิธีหา ADMIN_TARGET_ID" for how to find this.
ADMIN_TARGET_ID=

# Required for the quote-request flow (ส่งแบบขอใบเสนอราคา): a Google Cloud
# Service Account with the Sheets API enabled, shared as Editor on both
# sheets below. See README.md "ระบบขอใบเสนอราคา" for setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEET_ID_QUOTE_REQUESTS=1QwGekDNcxH_uOKMOtEnIwaC6wnw32Sf-ByRsJ1iQi5M
SHEET_ID_SESSION_STATE=1lq67oXwEE-WS_QFPO1_v8mfMlmvYGK0v8F5suibKH-o

# Optional: override if your sheet's tab name isn't the default "Sheet1"
SHEET_TAB_QUOTE_REQUESTS=Sheet1
SHEET_TAB_SESSION_STATE=Sheet1

# Optional: full liff.line.me URL for the "เลือกกระบวนการ" multi-select
# checkbox page (public/liff/processes.html). Without this, step 3 of the
# quote flow falls back to tap-one-at-a-time quick replies instead.
LIFF_PROCESSES_URL=
