LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: publicly readable CSV URL (Google Sheets "Publish to web" or
# /export?format=csv link). When set, FAQ answers are fetched from this
# sheet instead of data/faq.csv, with data/faq.csv used as a fallback.
SHEET_CSV_URL=

# Optional but recommended: LINE group ID that receives Smart Handoff
# notifications (customer wants a human / is complaining). See README.md
# "วิธีหา ADMIN_GROUP_ID" for how to find this.
ADMIN_GROUP_ID=
